# 复制为 .env.local 后填入实际值

# ─── 应用数据库（Prisma；Vercel + Neon 集成会自动设置）───
DATABASE_URL=postgresql://user:password@localhost:5432/ziwei_dev

# ─── 测试数据库（集成测试专用，绝不能指向 dev / production）───
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/ziwei_test

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：开源版不含 /api/interpret 等后端接口，下面这组配置只在你自己实现了接口后才会用到；
# 只想排盘、看命盘的话不用填。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Anthropic Claude（/api/interpret）───
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=your-anthropic-model

# ─── 登录（Auth.js + GitHub OAuth，#15）───
# AUTH_SECRET 用 `npx auth secret` 生成；production / preview 的值只在 Vercel 里设置。
AUTH_SECRET=your-random-auth-secret
# 本地开发用自己的 GitHub OAuth App，回调地址：http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# ─── 限流（AI 接口每小时次数，#9）───
# 留空则用进程内存计数，只适合本地开发；production / preview 需要 Redis，多个实例才共用一个计数。
# 格式：rediss://default:your-redis-password@your-redis-host:6379
REDIS_URL=
